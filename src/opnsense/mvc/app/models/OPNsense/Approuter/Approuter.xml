<model>
    <mount>//OPNsense/Approuter</mount>
    <version>1.0.0</version>
    <description>Application-Aware Routing Plugin</description>
    <items>
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <dnsResolver type="OptionField">
                <Default>dnsmasq</Default>
                <OptionValues>
                    <dnsmasq>Dnsmasq (ipset)</dnsmasq>
                    <unbound>Unbound (log watcher)</unbound>
                </OptionValues>
                <Required>Y</Required>
            </dnsResolver>
            <updateInterval type="OptionField">
                <Default>daily</Default>
                <OptionValues>
                    <hourly>Every Hour</hourly>
                    <daily>Daily</daily>
                    <weekly>Weekly</weekly>
                </OptionValues>
                <Required>Y</Required>
            </updateInterval>
            <tablePrefix type="TextField">
                <Default>approuter</Default>
                <Required>Y</Required>
                <Mask>/^[a-z][a-z0-9_]{0,30}$/</Mask>
                <ValidationMessage>Use lowercase letters, numbers and underscores only</ValidationMessage>
            </tablePrefix>
        </general>
        <rules>
            <rule type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <description type="TextField">
                    <Required>N</Required>
                </description>
                <sourceNets type="CSVListField">
                    <Required>Y</Required>
                    <FieldSeparator>,</FieldSeparator>
                    <Mask>/^[a-z0-9_:.\-\/ ,]+$/i</Mask>
                    <ValidationMessage>Enter "any", interface nets, aliases, or IP/subnet addresses</ValidationMessage>
                </sourceNets>
                <categories type="CSVListField">
                    <Required>N</Required>
                    <FieldSeparator>,</FieldSeparator>
                    <Mask>/^[a-z0-9_.,]+$/</Mask>
                    <ValidationMessage>Select at least one app category</ValidationMessage>
                </categories>
                <gateway type="CSVListField">
                    <Required>Y</Required>
                    <FieldSeparator>,</FieldSeparator>
                    <Mask>/^[a-zA-Z0-9_,\s]+$/</Mask>
                    <ValidationMessage>Enter one or more gateway names separated by commas</ValidationMessage>
                </gateway>
                <smartGateway type="BooleanField">
                    <Default>0</Default>
                    <Required>Y</Required>
                </smartGateway>
                <probeUrl type="TextField">
                    <Required>N</Required>
                </probeUrl>
                <probeInterval type="IntegerField">
                    <Default>300</Default>
                    <MinimumValue>30</MinimumValue>
                    <MaximumValue>3600</MaximumValue>
                    <Required>N</Required>
                    <ValidationMessage>Enter a value between 30 and 3600 seconds</ValidationMessage>
                </probeInterval>
                <probeMethod type="OptionField">
                    <Default>connect_only</Default>
                    <OptionValues>
                        <connect_only>TCP/TLS Connect Test</connect_only>
                        <status_code>HTTP Status Code</status_code>
                        <body_match>Response Body Match</body_match>
                        <latency>Latency Optimization</latency>
                    </OptionValues>
                    <Required>N</Required>
                </probeMethod>
                <probePattern type="TextField">
                    <Required>N</Required>
                </probePattern>
                <customDomains type="TextField">
                    <Required>N</Required>
                    <Mask>/^[a-z0-9_.,\-]*$/i</Mask>
                    <ValidationMessage>Enter comma-separated domains</ValidationMessage>
                </customDomains>
                <interface type="InterfaceField">
                    <Required>Y</Required>
                    <Default>lan</Default>
                    <Filters>
                        <enable>/^(?!loopback).*$/</enable>
                    </Filters>
                </interface>
            </rule>
        </rules>
        <customCategories>
            <category type="ArrayField">
                <slug type="TextField">
                    <Required>Y</Required>
                    <Mask>/^[a-z][a-z0-9_]{0,30}$/</Mask>
                    <ValidationMessage>Lowercase letters, numbers, underscores only (must start with a letter)</ValidationMessage>
                </slug>
                <label type="TextField">
                    <Required>Y</Required>
                </label>
                <domains type="TextField">
                    <Required>N</Required>
                </domains>
                <cidrs type="TextField">
                    <Required>N</Required>
                </cidrs>
            </category>
        </customCategories>
        <lists>
            <chinaDomainUrl type="UrlField">
                <Default>https://raw.githubusercontent.com/felixonmars/dnsmasq-china-list/master/accelerated-domains.china.conf</Default>
                <Required>N</Required>
            </chinaDomainUrl>
            <chinaCidrUrl type="UrlField">
                <Default>https://raw.githubusercontent.com/misakaio/chnroutes2/master/chnroutes.txt</Default>
                <Required>N</Required>
            </chinaCidrUrl>
            <customDomains type="TextField">
                <Required>N</Required>
            </customDomains>
            <customCidrs type="TextField">
                <Required>N</Required>
            </customCidrs>
        </lists>
    </items>
</model>
